# ============================================================
# Facial Recognition System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# Hugging Face API Token (optional — only needed if downloading gated models)
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Face matching similarity threshold (0.0 - 1.0)
# Lower = more matches (more false positives)
# Higher = fewer matches (more false negatives)
# Recommended for Indian faces: 0.40 - 0.50
SIMILARITY_THRESHOLD=0.45

# InsightFace model pack name
# Options: buffalo_l (best accuracy), buffalo_s (faster, less accurate), buffalo_sc (mobile)
MODEL_NAME=buffalo_l

# GPU device ID (0 = first GPU, -1 = CPU only)
GPU_ID=0

# Face detection size (higher = more accurate, slower)
DET_SIZE=640

# Maximum number of matches to return
TOP_K=5

# ChromaDB persistence directory
CHROMA_DB_DIR=./chroma_db
